---
import Mermaid from "@/components/Mermaid.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser";
import dateFormat from "@/lib/utils/dateFormat";
import { lastChangeDate, resolveContentDates, toIso } from "@/lib/utils/dates";
import { buildBreadcrumbJsonLd, buildWebPageJsonLd } from "@/lib/utils/jsonld";
import { buildCanonical, canonicalFor } from "@/lib/utils/seo";
import { checkDuplicateSlugs, pageSlug, pageUrl } from "@/lib/utils/slug";
import PageHeader from "@/partials/PageHeader.astro";
import { render } from "astro:content";

// get static paths for all pages
export async function getStaticPaths() {
  const COLLECTION_FOLDER = "pages";

  const pages = await getSinglePage(COLLECTION_FOLDER);

  // Two pages must never resolve to the same public URL (custom slug
  // colliding with another page's slug or filename). Fail the build loudly.
  checkDuplicateSlugs(pages, pageUrl, "page");

  const paths = pages.map((page) => ({
    params: {
      regular: pageSlug(page),
    },
    props: { page },
  }));
  return paths;
}

const { page } = Astro.props;
const {
  title,
  meta_title,
  seoTitle,
  description,
  seoDescription,
  image,
  og_title,
  ogTitle,
  og_description,
  ogDescription,
  og_image,
  ogImage,
  ogImageAlt,
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterImageAlt,
  pinterestTitle,
  pinterestDescription,
  pinterestImage,
  pinterestImageAlt,
  dateCreated,
  datePublished,
  dateModified,
  canonical,
  noindex,
} = page.data;
const { Content } = await render(page);

const pageCanonical = buildCanonical(canonical, pageUrl(page));
const dates = resolveContentDates({ dateCreated, datePublished, dateModified });
const updatedDate = lastChangeDate(dates);
const pageJsonLd = buildWebPageJsonLd({
  name: title,
  url: pageCanonical,
  description: description ?? undefined,
  dateCreated: toIso(dates.dateCreated),
  datePublished: toIso(dates.datePublished),
  dateModified: toIso(updatedDate),
});
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", url: canonicalFor("/") },
  { name: title, url: pageCanonical },
]);
---

<Base
  title={title}
  meta_title={meta_title}
  seoTitle={seoTitle}
  description={description}
  seoDescription={seoDescription}
  image={image}
  og_title={og_title}
  ogTitle={ogTitle}
  og_description={og_description}
  ogDescription={ogDescription}
  og_image={og_image}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  image_alt={title}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
  twitterImageAlt={twitterImageAlt}
  pinterestTitle={pinterestTitle}
  pinterestDescription={pinterestDescription}
  pinterestImage={pinterestImage}
  pinterestImageAlt={pinterestImageAlt}
  canonical={canonical}
  noindex={noindex}
  jsonLd={[pageJsonLd, breadcrumbJsonLd]}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div class="content">
            <Content />
          </div>
          {updatedDate && (
            <p class="mt-6 text-sm">
              Last updated:{" "}
              <time datetime={toIso(updatedDate)}>
                {dateFormat(updatedDate)}
              </time>
            </p>
          )}
          <Mermaid content={page.body} />
        </div>
      </div>
    </div>
  </section>
</Base>
