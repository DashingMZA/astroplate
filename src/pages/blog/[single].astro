---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getSinglePage } from "@/lib/contentParser";
import { displayAuthorNames, resolveAuthors } from "@/lib/utils/authors";
import {
  buildBlogJsonLd,
  buildBlogPostingJsonLd,
  buildBreadcrumbJsonLd,
} from "@/lib/utils/jsonld";
import { countWords } from "@/lib/utils/readingTime";
import { postImageUrls } from "@/lib/seo/sitemap/collectors";
import { slugify } from "@/lib/utils/textConverter";
import { lastChangeDate, resolveContentDates, toIso } from "@/lib/utils/dates";
import { absoluteUrl, buildCanonical, canonicalFor } from "@/lib/utils/seo";
import { checkDuplicateSlugs, postSlug, postUrl } from "@/lib/utils/slug";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const posts = await getSinglePage(BLOG_FOLDER);

  // Two posts must never resolve to the same public URL (custom slug
  // colliding with another post's slug or filename). Fail the build loudly.
  checkDuplicateSlugs(posts, postUrl, "blog post");

  const paths = posts.map((post) => ({
    params: {
      single: postSlug(post),
    },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;
const {
  title,
  seoTitle,
  ogTitle,
  ogDescription,
  excerpt,
  description,
  seoDescription,
  image,
  ogImage,
  ogImageAlt,
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterImageAlt,
  pinterestDescription,
  pinterestImage,
  dateCreated,
  datePublished,
  dateModified,
  authors,
  categories,
  tags,
  canonical,
  robotsindex,
} = post.data;

// Authors resolved against the authors collection by file id first
// (legacy display-name match only as a fallback). Unresolved names render
// as plain text with no link — never a 404 author URL.
const allAuthors = await getCollection("authors");
const resolvedAuthors = resolveAuthors(
  displayAuthorNames({ data: { authors } }),
  allAuthors,
);

const dates = resolveContentDates({ dateCreated, datePublished, dateModified });
const modifiedDate = lastChangeDate(dates);

// Canonical URL of this post: explicit frontmatter canonical wins,
// otherwise the custom-slug public URL.
const canonicalUrl = buildCanonical(canonical, postUrl(post));

// Structured data: BlogPosting (+ BreadcrumbList + the Blog node the
// BlogPosting `isPartOf` points at). Base merges these into the page's
// single @graph JSON-LD block. Field-for-field the site's schema specs:
// only the values are this post's own. The "others" default category /
// tag is filler, never a section or keyword.
const siteUrl = String(config.site.base_url ?? "").replace(/\/+$/, "");
const language = String(config.site.language ?? "en");
const firstCategory = (categories ?? []).find(
  (category: string) => category.toLowerCase() !== "others",
);
const keywords = (tags ?? []).filter(
  (tag: string) => tag.toLowerCase() !== "others",
);
const blogEntries = await getCollection("blog");
const blogIndex = blogEntries.find((entry) => entry.id === "-index");
const articleJsonLd = buildBlogPostingJsonLd(
  {
    headline: title,
    description: description ?? excerpt ?? undefined,
    image: postImageUrls(post),
    datePublished: toIso(dates.datePublished),
    dateModified: toIso(modifiedDate),
    authors: resolvedAuthors.map((a) => ({
      name: a.name,
      url: a.url ? absoluteUrl(a.url) : null,
    })),
    url: canonicalUrl,
    inLanguage: language,
    articleSection: firstCategory ?? undefined,
    keywords,
    wordCount: countWords(post.body ?? ""),
  },
  siteUrl,
);
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", url: canonicalFor("/") },
  { name: "Blog", url: canonicalFor("/blog") },
  ...(firstCategory
    ? [
        {
          name: firstCategory,
          url: canonicalFor(`/categories/${slugify(firstCategory)}`),
        },
      ]
    : []),
  { name: title, url: canonicalUrl },
]);
const blogJsonLd = buildBlogJsonLd({
  name: blogIndex?.data.title ?? "Blog",
  url: canonicalFor("/blog"),
  siteUrl,
});
---

<Base
  title={title}
  seoTitle={seoTitle}
  description={description}
  seoDescription={seoDescription}
  excerpt={excerpt}
  image={image}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
  twitterImageAlt={twitterImageAlt}
  pinterestDescription={pinterestDescription}
  pinterestImage={pinterestImage}
  ogType="article"
  article={{
    publishedTime: dates.datePublished,
    modifiedTime: modifiedDate,
    author: resolvedAuthors.map((a) => a.name),
    section: categories[0],
    tags,
  }}
  canonical={canonical}
  robotsindex={robotsindex}
  robotsType="blogPosts"
  jsonLd={[articleJsonLd, breadcrumbJsonLd, blogJsonLd]}
>
  <PostSingle post={post} />
</Base>
