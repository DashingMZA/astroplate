---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import type { CollectionEntry } from "astro:content";
import { absoluteUrl } from "@/lib/utils/seo";
import { checkDuplicateSlugs, postSlug } from "@/lib/utils/slug";
import { supportedLang } from "@/lib/utils/languageParser";

export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";

  const paths = await Promise.all(
    supportedLang.map(async (lang) => {
      const posts = await getSinglePage(BLOG_FOLDER, lang);

      // Two posts in the SAME language must never resolve to the same public
      // URL (custom slug colliding with another post's slug or filename).
      // Fail the build loudly. (Checked per language: en/post-1 and fr/post-1
      // legitimately share a slug.)
      const langNeutral = (post: CollectionEntry<"blog">) => ({
        id: post.id.split("/").slice(1).join("/"),
        data: post.data,
      });
      checkDuplicateSlugs(
        posts.map(langNeutral),
        (post) => `/blog/${postSlug(post)}`,
        "blog post",
      );

      return posts.map((post) => ({
        params: {
          lang: lang || undefined,
          single: postSlug(langNeutral(post)),
        },
        props: {
          post,
        },
      }));
    }),
  );
  return paths.flat();
}

const { post } = Astro.props;
const {
  title,
  meta_title,
  og_title,
  og_description,
  excerpt,
  description,
  image,
  og_image,
  date,
  updated,
  lastmod,
  author,
  authors,
  categories,
  tags,
  canonical,
  noindex,
} = post.data;

// Multi-author support: `authors` array when present, else the `author` field.
const displayAuthors: string[] =
  authors && authors.length > 0 ? authors : [author];

// Social-share image: per-post og_image wins, else the hero image.
const seoImage = og_image ?? image;
const modifiedDate = updated ?? lastmod ?? date;

// Article structured data, emitted once via Base's `jsonLd` prop.
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  image: seoImage ? [absoluteUrl(seoImage)] : undefined,
  datePublished: date ? new Date(date).toISOString() : undefined,
  dateModified: modifiedDate ? new Date(modifiedDate).toISOString() : undefined,
  author: displayAuthors.map((name: string) => ({
    "@type": "Person",
    name,
  })),
  publisher: {
    "@type": config.publisher?.type ?? "Organization",
    name: config.publisher?.name ?? config.site.title,
    ...(config.publisher?.logo
      ? {
          logo: {
            "@type": "ImageObject",
            url: absoluteUrl(config.publisher.logo),
          },
        }
      : {}),
  },
};
---

<Base
  title={title}
  meta_title={meta_title || og_title}
  og_description={og_description}
  excerpt={excerpt}
  description={description}
  image={seoImage}
  ogType="article"
  article={{
    publishedTime: date,
    modifiedTime: modifiedDate,
    author: displayAuthors,
    section: categories[0],
    tags,
  }}
  canonical={canonical}
  noindex={noindex}
  jsonLd={articleJsonLd}
>
  <PostSingle post={post} />
</Base>
