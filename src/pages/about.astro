---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";
import dateFormat from "@/lib/utils/dateFormat";
import { lastChangeDate, resolveContentDates, toIso } from "@/lib/utils/dates";
import { buildWebPageJsonLd } from "@/lib/utils/jsonld";
import { canonicalFor } from "@/lib/utils/seo";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

const aboutIndex = await getListPage("about", "-index");
const { Content } = await render(aboutIndex);
const {
  title,
  description,
  seoDescription,
  meta_title,
  seoTitle,
  image,
  og_title,
  ogTitle,
  og_description,
  ogDescription,
  og_image,
  ogImage,
  ogImageAlt,
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterImageAlt,
  pinterestTitle,
  pinterestDescription,
  pinterestImage,
  pinterestImageAlt,
} = aboutIndex.data;
const dates = resolveContentDates(aboutIndex.data);
const updatedDate = lastChangeDate(dates);
const pageJsonLd = buildWebPageJsonLd({
  name: title,
  url: canonicalFor("/about"),
  description: description ?? undefined,
  dateCreated: toIso(dates.dateCreated),
  datePublished: toIso(dates.datePublished),
  dateModified: toIso(updatedDate),
});

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && aboutIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  seoTitle={seoTitle}
  description={description}
  seoDescription={seoDescription}
  image={image}
  og_title={og_title}
  ogTitle={ogTitle}
  og_description={og_description}
  ogDescription={ogDescription}
  og_image={og_image}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  image_alt={title}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
  twitterImageAlt={twitterImageAlt}
  pinterestTitle={pinterestTitle}
  pinterestDescription={pinterestDescription}
  pinterestImage={pinterestImage}
  pinterestImageAlt={pinterestImageAlt}
  jsonLd={[pageJsonLd]}
>
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="md:col-10 lg:col-8">
          {image && (
            <ImageMod
              class="mx-auto mb-6 rounded"
              src={image}
              width={1200}
              height={600}
              alt={title}
              format="webp"
            />
          )}
          <h1 class="h3 mb-6">
            <span set:html={markdownify(title)} />
          </h1>
          <div class="content">
            <Content />
          </div>
          {updatedDate && (
            <p class="mt-6 text-sm">
              Last updated:{" "}
              <time datetime={toIso(updatedDate)}>
                {dateFormat(updatedDate)}
              </time>
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
</Base>
