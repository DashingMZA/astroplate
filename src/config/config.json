{
  "site": {
    "title": "Astroplate",
    "base_url": "https://astroplate.jadoo.bond",
    "base_path": "/",
    "trailing_slash": false,
    "language": "en",
    "locale": "en_US",
    "favicon": "/images/favicon.png",
    "logo": "/images/logo.png",
    "logo_darkmode": "/images/logo-darkmode.png",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "Astroplate"
  },

  "publisher": {
    "name": "Astroplate",
    "type": "Organization",
    "logo": "/images/logo.png",
    "url": "https://astroplate.jadoo.bond"
  },

  "social": {
    "twitter_site": "",
    "twitter_creator": ""
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": true,
    "content": "<span class='text-center block'>♥️ Loving Astroplate? <a class='underline' href='https://github.com/DashingMZA/astroplate' target='_blank' rel='noopener'>Please ⭐️ on Github</a></span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "Designed And Developed by [cSofts](https://csofts.com)"
  },

  // Contact form endpoint. The form has no backend of its own — it POSTs
  // to an external provider (Formspree, Getform, Netlify Forms, …).
  // - `action`: the provider's form endpoint URL, e.g.
  //   "https://formspree.io/f/xxxxxx". Empty (or "#") means the form is
  //   NOT configured: the contact page renders a visibly disabled form
  //   with setup instructions and never fakes a submission.
  // - `provider`: free-text provider name, shown on the contact page
  //   when configured (documentation only).
  // Legacy fallback: `params.contact_form_action` above, used only when
  // `contact_form.action` is absent. See CONFIGURATION.md for setup.
  "contact_form": {
    "action": "",
    "provider": ""
  },

  "navigation_button": {
    "enable": true,
    "label": "Edit with cSofts",
    "link": "https://app.csofts.tech/new/clone?name=AstroPlate&repository=https://github.com/DashingMZA/astroplate&aff=astroplate"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "csofts-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "cSofts",
    "meta_image": "/images/og-image.png",
    "meta_image_alt": "Astroplate",
    "meta_description": "Astro and Tailwind boilerplate"
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
