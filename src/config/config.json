{
  "site": {
    "title": "Astroplate",
    "base_url": "https://astroplate.jadoo.bond",
    "base_path": "/",
    "trailing_slash": false,
    "language": "en",
    "locale": "en_US",
    "favicon": "/favicon.png",
    "apple_touch_icon": "/apple-touch-icon.png",
    "web_manifest": "/manifest.webmanifest",
    "logo": "/logo.png",
    "logo_darkmode": "/logo-darkmode.png",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "Astroplate"
  },

  "publisher": {
    "name": "Astroplate",
    "type": "Organization",
    "logo": "/logo.png",
    "url": "https://astroplate.jadoo.bond"
  },

  "social": {
    "twitter_site": "@Dashing_ZB",
    "twitter_creator": "@Dashing_ZB"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": true,
    "content": "<span class='text-center block'>♥️ Loving Astroplate? <a class='underline' href='https://github.com/DashingMZA/astroplate' target='_blank' rel='noopener'>Please ⭐️ on Github</a></span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "Designed And Developed by [cSofts](https://csofts.com)"
  },

  "contact_form": {
    "action": "",
    "provider": ""
  },

  "navigation_button": {
    "enable": true,
    "label": "Edit with cSofts",
    "link": "https://app.csofts.tech/new/clone?name=AstroPlate&repository=https://github.com/DashingMZA/astroplate&aff=astroplate"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "csofts-template",
    "settings": {}
  },

  "open-remark-comment": {
    "enable": true,
    "siteKey": "cmwegg6rg000607ld1tlt5ilh"
  },

  "metadata": {
    "meta_author": "cSofts",
    "meta_image": "/images/og-image.webp",
    "meta_twitter_image": "/images/og-image.webp",
    "meta_image_alt": "Astroplate",
    "meta_description": "Astro and Tailwind boilerplate"
  },

  "verification": {
    "pinterest": "",
    "facebook": "",
    "google": "",
    "bing": "",
    "yandex": "",
    "baidu": "",
    "naver": "",
    "ahrefs": ""
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": [],
    "show_tags": false,
    "show_categories": false,
    "show_authors": false,
    "show_pagination": false
  },

  "feeds": {
    "limit": 20,
    "atom_logo": "/atom-logo.png",
    "icon": "/feed-icon.png"
  },

  "sitemap": {
    "enable": true,
    "index_filename": "sitemap_index.xml",
    "lastmod": true,
    "exclude": ["/404"],
    "exclude_segments": ["draft", "drafts", "preview", "private"],
    "max_urls_per_sitemap": 1000,
    "max_bytes": 52428800,
    "types": {
      "pages": { "enable": true, "filename": "page-sitemap.xml" },
      "posts": { "enable": true, "filename": "post-sitemap.xml" },
      "categories": { "enable": true, "filename": "category-sitemap.xml" },
      "tags": { "enable": true, "filename": "post_tag-sitemap.xml" },
      "authors": { "enable": true, "filename": "author-sitemap.xml" },
      "images": { "enable": true, "filename": "image-sitemap.xml" },
      "videos": { "enable": false, "filename": "video-sitemap.xml" },
      "news": { "enable": false, "filename": "news-sitemap.xml" },
      "products": { "enable": false, "filename": "product-sitemap.xml" },
      "locales": { "enable": false, "filename": "locales-sitemap.xml" },
      "locations": { "enable": false, "filename": "locations-sitemap.xml" }
    }
  },

  "robots": {
    "index": {
      "pages": true,
      "blogPosts": true,
      "authors": false,
      "tags": false,
      "categories": false,
      "blogArchives": false
    }
  }
}
