---
import { supportedLang } from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";

export interface BreadcrumbItem {
  label: string;
  /** Omitted for the current page (rendered as plain text). */
  href?: string;
}

const { className, items }: { className?: string; items?: BreadcrumbItem[] } =
  Astro.props;

// When `items` are passed (post / author pages), the trail uses the
// resolved page titles — never a humanised URL slug. Otherwise the trail is
// derived from the URL segments, keeping a `page/N` segment as "Page N".
// Multilingual: the leading language segment is stripped from the trail and
// used as the href prefix (fr pages link under /fr/…).
const urlPaths = Astro.url.pathname.split("/").filter((x) => x);
let lang = "";
if (supportedLang.includes(urlPaths[0])) {
  lang = urlPaths.shift()!;
}
const baseHref = lang ? `/${lang}/` : "/";
let parts: { label: string; href?: string }[] = [
  { label: "Home", href: baseHref },
];

if (items && items.length > 0) {
  parts = items.map((item) => ({ label: item.label, href: item.href }));
} else {
  const paths = urlPaths;
  for (let i = 0; i < paths.length; i++) {
    const segment = paths[i];
    // `/blog/page/2` keeps its page number instead of dropping the segment.
    if (
      segment === "page" &&
      i + 1 < paths.length &&
      /^\d+$/.test(paths[i + 1])
    ) {
      const href = `${baseHref}${paths.slice(0, i + 2).join("/")}`;
      parts.push({ label: `Page ${paths[i + 1]}`, href });
      i++;
      continue;
    }
    const href = `${baseHref}${paths.slice(0, i + 1).join("/")}`;
    parts.push({
      label: humanize(segment.replace(".html", "").replace(/[-_]/g, " ")) || "",
      href,
    });
  }
}
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="inline-flex">
    {parts.map(({ label, href }, index) => {
      const isCurrent = index === parts.length - 1;
      return (
        <li class="mx-1 capitalize">
          {index > 0 && <span class="inlin-block mr-1">/</span>}
          {!isCurrent && href ? (
            <a class="text-primary dark:text-darkmode-primary" href={href}>
              {label}
            </a>
          ) : (
            <span
              class="text-text-light dark:text-darkmode-text-light"
              aria-current="page"
            >
              {label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
