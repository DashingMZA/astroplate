---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Only h2/h3 headings belong in the table of contents.
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

interface TocItem {
  slug: string;
  text: string;
  children: TocItem[];
}

// Nest h3 headings under the preceding h2; an h3 with no preceding h2
// becomes a top-level entry so nothing is dropped.
const toc: TocItem[] = [];
for (const heading of tocHeadings) {
  const item: TocItem = {
    slug: heading.slug,
    text: heading.text,
    children: [],
  };
  if (heading.depth === 3 && toc.length > 0) {
    toc[toc.length - 1].children.push(item);
  } else {
    toc.push(item);
  }
}
---

{toc.length > 0 && (
  <nav aria-label="Table of contents" class="toc mb-10">
    <h2 class="h5 mb-4">Table of contents</h2>
    <ul>
      {toc.map((item) => (
        <li>
          <a href={`#${item.slug}`}>{item.text}</a>
          {item.children.length > 0 && (
            <ul>
              {item.children.map((child) => (
                <li>
                  <a href={`#${child.slug}`}>{child.text}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}
