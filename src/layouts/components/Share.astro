---
import config from "@/config/config.json";
import { canonicalFor } from "@/lib/utils/seo";
import { resolveSocialMeta } from "@/lib/utils/social";
import {
  IoLogoFacebook,
  IoLogoLinkedin,
  IoLogoPinterest,
  IoLogoTwitter,
} from "react-icons/io5";

const { base_url }: { base_url: string } = config.site;
const {
  title,
  description,
  slug,
  url,
  image,
  className,
  ogImage,
  twitterTitle,
  twitterDescription,
  twitterImage,
  pinterestTitle,
  pinterestDescription,
  pinterestImage,
}: {
  title?: string;
  description?: string;
  slug?: string;
  url?: string;
  image?: string;
  className?: string;
  ogImage?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  pinterestTitle?: string;
  pinterestDescription?: string;
  pinterestImage?: string;
} = Astro.props;

// Preferred: full absolute canonical URL passed by the caller.
// Fallback: a bare slug (e.g. post id "post-1" or a custom slug) resolves to
// the post's canonical URL via canonicalFor, so share links always agree
// with the page canonical (base_path / trailing_slash aware).
const cleanSlug = slug ? slug.replace(/^\/+/, "").replace(/^blog\//, "") : "";
const shareUrl = url
  ? url
  : cleanSlug
    ? canonicalFor(`/blog/${cleanSlug}`)
    : base_url;

// Platform-specific share text/image come from the centralized social
// resolver (same fallback chains as the <head> metadata): X uses the
// resolved Twitter title, Pinterest uses the resolved Pin title /
// description / image. Nothing here re-implements a fallback.
const social = await resolveSocialMeta({
  title,
  description,
  image,
  ogImage,
  twitterTitle,
  twitterDescription,
  twitterImage,
  pinterestTitle,
  pinterestDescription,
  pinterestImage,
});

// Share targets take these as query params, so every value must be
// percent-encoded: raw titles/URLs with spaces, "&", "?", or Unicode
// (e.g. "Café Guide & Tips!") would otherwise truncate or corrupt the link.
const encUrl = encodeURIComponent(shareUrl);
const encTitle = encodeURIComponent(title ?? "");
const encDescription = encodeURIComponent(description ?? "");
const encTwitterTitle = encodeURIComponent(social.twitter.title);
const encPinDescription = encodeURIComponent(social.pinterest.description);
const encPinImage = encodeURIComponent(social.pinterest.image.url);
const encSource = encodeURIComponent(base_url);
---

<ul class={`${className}`}>
  <li class="inline-block">
    <a
      aria-label="facebook share button"
      href={`https://facebook.com/sharer/sharer.php?u=${encUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoFacebook />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="twitter share button"
      href={`https://twitter.com/intent/tweet/?text=${encTwitterTitle}&url=${encUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoTwitter />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="linkedin share button"
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${encUrl}&title=${encTitle}&summary=${encDescription}&source=${encSource}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoLinkedin />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="pinterest share button"
      href={`https://pinterest.com/pin/create/button/?url=${encUrl}&media=${encPinImage}&description=${encPinDescription}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoPinterest />
    </a>
  </li>
</ul>
