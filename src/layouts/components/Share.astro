---
import config from "@/config/config.json";
import { absoluteUrl } from "@/lib/utils/seo";
import {
  IoLogoFacebook,
  IoLogoLinkedin,
  IoLogoPinterest,
  IoLogoTwitter,
} from "react-icons/io5";

const { base_url }: { base_url: string } = config.site;
const {
  title,
  description,
  slug,
  url,
  image,
  className,
}: {
  title?: string;
  description?: string;
  slug?: string;
  url?: string;
  image?: string;
  className?: string;
} = Astro.props;

// Preferred: full absolute canonical URL passed by the caller.
// Fallback: a bare slug (e.g. post id "post-1") resolves to /blog/<slug>.
const cleanSlug = slug ? slug.replace(/^\/+/, "").replace(/^blog\//, "") : "";
const shareUrl = url
  ? url
  : cleanSlug
    ? `${base_url}/blog/${cleanSlug}`
    : base_url;
const shareImage = image ? absoluteUrl(image) : "";
---

<ul class={`${className}`}>
  <li class="inline-block">
    <a
      aria-label="facebook share button"
      href={`https://facebook.com/sharer/sharer.php?u=${shareUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoFacebook />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="twitter share button"
      href={`https://twitter.com/intent/tweet/?text=${title}&amp;url=${shareUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoTwitter />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="linkedin share button"
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${title}&summary=${description}&source=${base_url}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoLinkedin />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="pinterest share button"
      href={`https://pinterest.com/pin/create/button/?url=${shareUrl}&media=${shareImage}&description=${description}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoPinterest />
    </a>
  </li>
</ul>
