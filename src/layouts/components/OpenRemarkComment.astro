---
// Pass the slug dynamically from Astro.params:
const { siteKey } = Astro.props;
---

<div data-open-remark data-site-key={siteKey}>
  <noscript>
    <p>
      Comments require JavaScript. Enable JavaScript to view and post comments.
    </p>
  </noscript>
</div>

<script is:inline>
  function loadOpenRemark() {
    const host = document.querySelector("[data-open-remark]");
    // Guard against double-mounting: this runs once on initial load AND
    // again on astro:page-load, and a second embed.js execution throws
    // (attachShadow on a host that already has a shadow tree). Skip when
    // this host is already mounted or loading; a fresh host (after a page
    // transition) still mounts normally.
    if (!host || host.shadowRoot || host.dataset.openRemarkLoading) return;
    host.dataset.openRemarkLoading = "true";

    const oldScript = document.querySelector("script[data-open-remark-script]");
    if (oldScript) oldScript.remove();

    const script = document.createElement("script");
    script.src = "https://openremark.bond/embed.js";
    script.async = true;
    script.setAttribute("data-open-remark-script", "true");
    document.body.appendChild(script);
  }

  loadOpenRemark();

  // re-mount on Astro page transitions
  document.addEventListener("astro:page-load", loadOpenRemark);
</script>
