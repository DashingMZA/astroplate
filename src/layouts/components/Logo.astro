---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src, srcDarkmode }: { src?: string; srcDarkmode?: string } =
  Astro.props;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: string | number;
  logo_height: string | number;
  logo_text: string;
  title: string;
} = config.site;

// Logo dimensions come from config as "150" / "150px" (or a bare number).
// Parse defensively: a non-numeric value used to produce NaN dimensions
// at runtime (`"px"` stripped from a non-numeric string); fall back to
// the theme defaults instead.
const parseDimension = (value: string | number, fallback: number): number => {
  const parsed =
    typeof value === "number"
      ? value
      : Number.parseInt(String(value).replace("px", ""), 10);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
};
const logoWidth = parseDimension(logo_width, 150);
const logoHeight = parseDimension(logo_height, 30);

const { theme_switcher }: { theme_switcher: boolean } = config.settings;
---

<a href="/" class="navbar-brand inline-block">
  {src || srcDarkmode || logo || logo_darkmode ? (
    <>
      <ImageMod
        src={src ? src : logo}
        class={`inline-block ${theme_switcher && "dark:hidden"}`}
        width={logoWidth * 2}
        height={logoHeight * 2}
        alt={title}
        loading="eager"
        fetchpriority="high"
        style={{
          height: logoHeight + "px",
          width: logoWidth + "px",
        }}
        format="webp"
      />
      {theme_switcher && (
        <ImageMod
          src={srcDarkmode ? srcDarkmode : logo_darkmode}
          class={"hidden dark:inline-block"}
          width={logoWidth * 2}
          height={logoHeight * 2}
          alt={title}
          loading="eager"
          fetchpriority="high"
          style={{
            height: logoHeight + "px",
            width: logoWidth + "px",
          }}
          format="webp"
        />
      )}
    </>
  ) : logo_text ? (
    logo_text
  ) : (
    title
  )}
</a>
