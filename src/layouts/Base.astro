---
import JsonLd from "@/components/JsonLd.astro";
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { absoluteUrl, buildCanonical } from "@/lib/utils/seo";
import { resolveSocialMeta } from "@/lib/utils/social";
import {
  buildOrganizationJsonLd,
  buildWebsiteJsonLd,
} from "@/lib/utils/jsonld";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
// KaTeX styles for rendered math (remark-math + rehype-katex). The CSS is
// global by design — math can appear on any content page — while the
// mermaid JS stays per-page (see Mermaid.astro).
import "katex/dist/katex.min.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Announcement from "./helpers/Announcement.astro";
import SearchModal from "./helpers/SearchModal";
import { toIso } from "@/lib/utils/dates";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// Article metadata for og:type="article" pages (blog posts).
export interface ArticleMeta {
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string | string[];
  section?: string;
  tags?: string[];
}

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  excerpt?: string;
  image?: string;
  og_title?: string;
  og_description?: string;
  og_image?: string;
  /** Alt text for a page-specific OG image (defaults to the page title). */
  og_image_alt?: string;
  /** Alias of og_image_alt, kept for call sites that pass `image_alt`. */
  image_alt?: string;
  /** Independent social metadata (all optional; see social.ts for the
   * exact fallback chains). snake_case spellings above are legacy
   * aliases and keep working. */
  seoTitle?: string;
  seoDescription?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  pinterestTitle?: string;
  pinterestDescription?: string;
  pinterestImage?: string;
  pinterestImageAlt?: string;
  /** Pagination neighbours (absolute URLs); emitted as rel=prev/next. */
  prevUrl?: string;
  nextUrl?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  article?: ArticleMeta;
  jsonLd?: unknown;
}

// destructure frontmatter
const {
  title,
  meta_title,
  description,
  excerpt,
  image,
  og_title,
  og_description,
  og_image,
  og_image_alt,
  image_alt,
  seoTitle,
  seoDescription,
  ogTitle: ogTitleProp,
  ogDescription: ogDescriptionProp,
  ogImage: ogImageProp,
  ogImageAlt: ogImageAltProp,
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterImageAlt,
  pinterestTitle,
  pinterestDescription,
  pinterestImage,
  pinterestImageAlt,
  prevUrl,
  nextUrl,
  noindex,
  canonical,
  ogType,
  article,
  jsonLd,
} = Astro.props;

// All titles / descriptions / images (OG, Twitter, Pinterest) come from
// the single centralized resolver in src/lib/utils/social.ts — see its
// header comment for the exact fallback chains. plainify() strips any
// Markdown so it never lands inside a <title> or meta content attribute
// (it leaves a trailing newline from marked's block output — trim it).
const social = await resolveSocialMeta({
  title,
  meta_title,
  seoTitle,
  description,
  excerpt,
  seoDescription,
  image,
  og_title,
  ogTitle: ogTitleProp,
  og_description,
  ogDescription: ogDescriptionProp,
  og_image,
  ogImage: ogImageProp,
  og_image_alt,
  ogImageAlt: ogImageAltProp,
  image_alt,
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterImageAlt,
  pinterestTitle,
  pinterestDescription,
  pinterestImage,
  pinterestImageAlt,
});
const pageTitle = plainify(social.title).trim();
const pageDescription = plainify(social.description).trim();
const ogTitle = plainify(social.og.title).trim();
const ogDescription = plainify(social.og.description).trim();
const twitterTitleResolved = plainify(social.twitter.title).trim();
const twitterDescriptionResolved = plainify(social.twitter.description).trim();

// Canonical: always emitted. An explicit `canonical` prop overrides the
// page's own public URL (absolute URLs are trailing-slash normalised,
// relative paths resolved); otherwise the current pathname is canonical.
const canonicalUrl = buildCanonical(canonical, Astro.url.pathname);

// og:url is the canonical URL.
const ogUrl = canonicalUrl;

// og:type: "article" when article metadata is passed (or explicitly set),
// "website" otherwise.
const resolvedOgType = ogType ?? (article ? "article" : "website");

// Image metadata (URL + verified width/height/MIME/alt) comes from the
// resolver: dimensions are probed from the actual file with sharp at
// build time. Remote images carry no dimensions — invented dimensions
// are worse than none.
const ogImage = social.og.image;
const twitterImageMeta = social.twitter.image;
const ogImageAlt = plainify(ogImage.alt).trim();
const twitterImageAltText = plainify(twitterImageMeta.alt).trim();

const articleAuthors = article?.author
  ? Array.isArray(article.author)
    ? article.author
    : [article.author]
  : [];

// Structured data: exactly ONE JSON-LD script per page — a @graph holding
// the site-wide WebSite + Organization blocks plus any page-specific blocks
// (BlogPosting, BreadcrumbList, Person) passed via the `jsonLd` prop.
const siteUrl = String(config.site.base_url ?? "").replace(/\/+$/, "");
const siteGraph = [
  buildWebsiteJsonLd(siteUrl, config.site.title),
  buildOrganizationJsonLd(
    config.publisher
      ? {
          ...config.publisher,
          // JSON-LD logo must be an absolute URL.
          logo: config.publisher.logo
            ? absoluteUrl(config.publisher.logo)
            : undefined,
        }
      : null,
    siteUrl,
  ),
].filter(Boolean);
const pageBlocks = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [...siteGraph, ...pageBlocks],
};
---

<!doctype html>
<html lang={config.site.language ?? "en"}>
  <head>
    <!-- google tag manager -->
    {config.google_tag_manager.enable && (
      <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
    )}
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- theme meta -->
    <meta name="theme-name" content="astroplate" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta charset="utf-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {fontEntries.map(([key]) => {
      // Font's cssVariable only accepts the variables declared in theme.json
      // (`--font-primary` / `--font-secondary`); derive that union from the
      // theme keys instead of casting to `any`.
      const cssVar = `--font-${key}` as `--font-${Exclude<
        keyof typeof theme.fonts.font_family,
        `${string}_type`
      >}`;
      return <Font cssVariable={cssVar} preload />;
    })}

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url (always emitted; defaults to this page's own URL) -->
    <link rel="canonical" href={canonicalUrl} />
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}

    <!-- rss feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href={absoluteUrl("/rss.xml")}
    />

    <!-- atom feed -->
    <link
      rel="alternate"
      type="application/atom+xml"
      title={config.site.title}
      href={absoluteUrl("/atom.xml")}
    />

    <!-- json feed -->
    <link
      rel="alternate"
      type="application/feed+json"
      title={config.site.title}
      href={absoluteUrl("/feed.json")}
    />

    <!-- noindex robots (only emitted when a page opts out; the default is index,follow) -->
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- open graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content={config.site.locale ?? "en_US"} />
    {resolvedOgType === "article" && article && (
      <>
        {toIso(article.publishedTime) && (
          <meta
            property="article:published_time"
            content={toIso(article.publishedTime)}
          />
        )}
        {toIso(article.modifiedTime) && (
          <meta
            property="article:modified_time"
            content={toIso(article.modifiedTime)}
          />
        )}
        {articleAuthors.map((author: string) => (
          <meta property="article:author" content={author} />
        ))}
        {article.section && (
          <meta property="article:section" content={article.section} />
        )}
        {article.tags?.map((tag: string) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- og-image (dimensions/MIME verified from the actual file; omitted when unverifiable) -->
    <meta property="og:image" content={ogImage.url} />
    {ogImage.secureUrl && (
      <meta property="og:image:secure_url" content={ogImage.secureUrl} />
    )}
    {ogImage.type && <meta property="og:image:type" content={ogImage.type} />}
    {ogImage.width && (
      <meta property="og:image:width" content={String(ogImage.width)} />
    )}
    {ogImage.height && (
      <meta property="og:image:height" content={String(ogImage.height)} />
    )}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <!-- twitter (independent fields; each falls back through OG when unset — see social.ts) -->
    <meta name="twitter:card" content={social.twitter.card} />
    <meta name="twitter:title" content={twitterTitleResolved} />
    <meta name="twitter:description" content={twitterDescriptionResolved} />
    <meta name="twitter:image" content={twitterImageMeta.url} />
    {twitterImageAltText && (
      <meta name="twitter:image:alt" content={twitterImageAltText} />
    )}
    {social.twitter.site && (
      <meta name="twitter:site" content={social.twitter.site} />
    )}
    {social.twitter.creator && (
      <meta name="twitter:creator" content={social.twitter.creator} />
    )}

    <!-- structured data (one @graph block per page) -->
    <JsonLd data={jsonLdGraph} />
  </head>
  <body class="flex flex-col min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-black"
    >
      Skip to content
    </a>
    {/* google tag manager noscript */}
    {config.google_tag_manager.enable && (
      <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
    )}
    <Announcement />
    <Header />
    <SearchModal client:only="react" />
    <main class="grow" id="main-content">
      <slot />
    </main>
    <Footer />
    <TwSizeIndicator />
  </body>
</html>
