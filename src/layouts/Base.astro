---
import JsonLd from "@/components/JsonLd.astro";
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import {
  absoluteUrl,
  buildCanonical,
  resolveOgDescription,
  resolveOgImage,
  resolveOgTitle,
  resolvePageDescription,
  resolvePageTitle,
  resolveTwitterHandles,
} from "@/lib/utils/seo";
// Site-wide WebSite + Organization JSON-LD builders land with 90ac0dc
// (src/lib/utils/jsonld.ts); until then pages emit only their own blocks.
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
// KaTeX styles for rendered math (remark-math + rehype-katex). The CSS is
// global by design — math can appear on any content page — while the
// mermaid JS stays per-page (see Mermaid.astro).
import "katex/dist/katex.min.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Announcement from "./helpers/Announcement";
import SearchModal from "./helpers/SearchModal";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// Article metadata for og:type="article" pages (blog posts).
export interface ArticleMeta {
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string | string[];
  section?: string;
  tags?: string[];
}

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  excerpt?: string;
  image?: string;
  og_title?: string;
  og_description?: string;
  og_image?: string;
  /** Alt text for a page-specific OG image (defaults to the page title). */
  og_image_alt?: string;
  /** Alias of og_image_alt, kept for call sites that pass `image_alt`. */
  image_alt?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  article?: ArticleMeta;
  jsonLd?: unknown;
  // Multilingual: explicit page language override; otherwise derived
  // from the URL (en at root, fr under /fr/...).
  lang?: string;
}

// destructure frontmatter
const {
  title,
  meta_title,
  description,
  excerpt,
  image,
  og_title,
  og_description,
  og_image,
  og_image_alt,
  image_alt,
  noindex,
  canonical,
  ogType,
  article,
  jsonLd,
  lang,
} = Astro.props;

// Multilingual: page language from the prop or the URL.
const language = lang || getLangFromUrl(Astro.url);

// <title>: meta_title > title > site title. og_title is NOT a title fallback.
// plainify() leaves a trailing newline from marked's block output — trim it
// so it never lands inside a <title> or meta content attribute.
const pageTitle = plainify(resolvePageTitle({ meta_title, title })).trim();
// meta description: description > excerpt > site default.
const pageDescription = plainify(
  resolvePageDescription({ description, excerpt }),
).trim();
// og:title: og_title > meta_title > title > site title.
// og:description: og_description > description > excerpt > site default.
const ogTitle = plainify(
  resolveOgTitle({ og_title, meta_title, title }),
).trim();
const ogDescription = plainify(
  resolveOgDescription({ og_description, description, excerpt }),
).trim();

// Canonical: always emitted. An explicit `canonical` prop overrides the
// page's own public URL (absolute URLs are trailing-slash normalised,
// relative paths resolved); otherwise the current pathname is canonical.
const canonicalUrl = buildCanonical(canonical, Astro.url.pathname);

// og:url is the canonical URL.
const ogUrl = canonicalUrl;

// og:type: "article" when article metadata is passed (or explicitly set),
// "website" otherwise.
const resolvedOgType = ogType ?? (article ? "article" : "website");

// OG / Twitter image: og_image > image > site default. Absolute URLs (e.g.
// R2/CDN) are never prefixed with base_url.
const { url: ogImage, isPageImage } = resolveOgImage({ og_image, image });
// No og:image:width/height is emitted: image dimensions are not known at
// render time, and the previous hardcoded 1200x630 was wrong even for the
// default OG image (3600x2400). Invented dimensions are worse than none.
const twitterCard = ogImage ? "summary_large_image" : "summary";
// Alt follows the image source: a page-specific image gets the page's alt
// (og_image_alt / image_alt / page title); the site-default image keeps the
// configured default alt.
const ogImageAlt = isPageImage
  ? (og_image_alt ?? image_alt ?? title ?? config.metadata.meta_image_alt)
  : config.metadata.meta_image_alt;
const twitterHandles = resolveTwitterHandles();

const toIsoDate = (value?: string | Date) => {
  if (!value) return undefined;
  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.valueOf()) ? undefined : date.toISOString();
};
const articleAuthors = article?.author
  ? Array.isArray(article.author)
    ? article.author
    : [article.author]
  : [];

// Structured data: the single @graph assembly (site-wide WebSite +
// Organization blocks + page blocks) lands with 90ac0dc. Until then the
// page's own block, if any, is emitted as-is.
---

<!doctype html>
<html lang={language}>
  <head>
    <!-- google tag manager -->
    {config.google_tag_manager.enable && (
      <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
    )}
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="astroplate" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {fontEntries.map(([key]) => {
      // Font's cssVariable only accepts the variables declared in theme.json
      // (`--font-primary` / `--font-secondary`); derive that union from the
      // theme keys instead of casting to `any`.
      const cssVar = `--font-${key}` as `--font-${Exclude<
        keyof typeof theme.fonts.font_family,
        `${string}_type`
      >}`;
      return <Font cssVariable={cssVar} preload />;
    })}

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url (always emitted; defaults to this page's own URL) -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- rss feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href={absoluteUrl("/rss.xml")}
    />

    <!-- noindex robots (only emitted when a page opts out; the default is index,follow) -->
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- open graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content={config.site.title} />
    {/*
      Multilingual: og:locale follows the page language (fr pages are
      fr_FR); other languages fall back to the configured locale.
    */}
    <meta
      property="og:locale"
      content={language === "fr" ? "fr_FR" : (config.site.locale ?? "en_US")}
    />
    {resolvedOgType === "article" && article && (
      <>
        {toIsoDate(article.publishedTime) && (
          <meta
            property="article:published_time"
            content={toIsoDate(article.publishedTime)}
          />
        )}
        {toIsoDate(article.modifiedTime) && (
          <meta
            property="article:modified_time"
            content={toIsoDate(article.modifiedTime)}
          />
        )}
        {articleAuthors.map((author: string) => (
          <meta property="article:author" content={author} />
        ))}
        {article.section && (
          <meta property="article:section" content={article.section} />
        )}
        {article.tags?.map((tag: string) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- og-image -->
    <meta property="og:image" content={ogImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <!-- twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {twitterHandles.site && (
      <meta name="twitter:site" content={twitterHandles.site} />
    )}
    {twitterHandles.creator && (
      <meta name="twitter:creator" content={twitterHandles.creator} />
    )}

    <!-- structured data -->
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body class="flex flex-col min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-black"
    >
      Skip to content
    </a>
    {/* google tag manager noscript */}
    {config.google_tag_manager.enable && (
      <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
    )}
    <Announcement lang={language} client:only="react" />
    <Header />
    <SearchModal lang={language} client:only="react" />
    <main class="grow" id="main-content">
      <slot />
    </main>
    <Footer />
    <TwSizeIndicator />
  </body>
</html>
