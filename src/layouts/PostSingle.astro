---
import config from "@/config/config.json";
import BlogCard from "@/components/BlogCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Mermaid from "@/components/Mermaid.astro";
import Share from "@/components/Share.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import config from "@/config/config.json";
import Disqus from "@/helpers/Disqus";
import { getSinglePage } from "@/lib/contentParser";
import { displayAuthorNames, resolveAuthors } from "@/lib/utils/authors";
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import { canonicalFor } from "@/lib/utils/seo";
import { postSlug, postUrl } from "@/lib/utils/slug";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { getCollection, render } from "astro:content";
import { FaRegClock, FaRegFolder, FaRegUserCircle } from "react-icons/fa";
import ImageMod from "./components/ImageMod.astro";

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;
const { default_language } = config.settings;
let { lang } = Astro.params;

if (!lang) {
  lang = default_language;
}

const posts = await getSinglePage(COLLECTION_FOLDER, lang);
// Ranked by shared categories, then shared tags, then recency; capped at 3.
const similarPosts = similarItems(post, posts).slice(0, 3);
const { Content, headings } = await render(post);
const { title, description, author, authors, categories, image, date, tags } =
  post.data;

// Reading time from the raw Markdown body.
const reading_time = readingTime(post.body ?? "");

// Authors resolved against the authors collection (file id first, legacy
// display-name match as fallback). Unresolved names render as plain text
// with no link — never a link to a 404 author page.
const allAuthors = await getCollection("authors");
const langAuthors = allAuthors.map((a) => ({
  ...a,
  id: a.id.split("/").slice(1).join("/"),
}));
const resolvedAuthors = resolveAuthors(
  displayAuthorNames({ data: { author, authors } }),
  langAuthors,
);
// Language-neutral id for the slug helpers (post.id is "english/post-1").
const postId = post.id.split("/").slice(1).join("/");
const postSlugValue = postSlug({ id: postId, data: post.data });
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        <Breadcrumbs
          items={[
            { label: "Home", href: slugSelector("/", lang) },
            { label: "Blog", href: slugSelector("/blog", lang) },
            { label: title },
          ]}
        />
        {image && (
          <div class="mb-10">
            <ImageMod
              src={image}
              height={500}
              width={1200}
              alt={title}
              loading="eager"
              fetchpriority="high"
              class="w-full rounded"
              format="webp"
              sizes="(max-width: 768px) 100vw, 1200px"
              widths={[640, 1024, 1200]}
            />
          </div>
        )}
        <h1 class="h2 mb-4">
          <span set:html={markdownify(title)} />
        </h1>
        <ul class="mb-4">
          <li class="mr-4 inline-block">
            {resolvedAuthors.map((resolved, index: number) => (
              <>
                {resolved.url ? (
                  <a href={slugSelector(resolved.url, lang)}>
                    <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
                    {humanize(resolved.name)}
                  </a>
                ) : (
                  <span>
                    <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
                    {humanize(resolved.name)}
                  </span>
                )}
                {index !== resolvedAuthors.length - 1 && ", "}
              </>
            ))}
          </li>
          <li class="mr-4 inline-block">
            <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
            {categories.map((category: string, index: number) => (
              <a href={slugSelector(`/categories/${slugify(category)}`, lang)}>
                {humanize(category)}
                {index !== categories.length - 1 && ","}
              </a>
            ))}
          </li>
          <li class="mr-4 inline-block">
            <FaRegClock className={"mr-2 -mt-1 inline-block"} />
            {dateFormat(date)}
          </li>
          <li class="mr-4 inline-block">{reading_time}</li>
        </ul>
        <TableOfContents headings={headings} />
        <div class="content mb-10">
          <Content />
        </div>
        <Mermaid content={post.body} />
        <div class="row items-start justify-between">
          <div class="mb-10 flex items-center lg:col-5 lg:mb-0">
            <span class="h5 mr-3">Tags :</span>
            <ul>
              {tags.map((tag: string) => (
                <li class="inline-block">
                  <a
                    class="m-1 block rounded bg-light px-3 py-1 hover:bg-primary hover:text-white dark:bg-darkmode-light dark:hover:bg-darkmode-primary dark:hover:text-text-dark"
                    href={slugSelector(`/tags/${slugify(tag)}`, lang)}
                  >
                    {humanize(tag)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="flex items-center lg:col-4">
            <span class="h5 mr-3">Share :</span>
            <Share
              className="social-icons"
              title={title}
              description={description}
              slug={postSlugValue}
              url={canonicalFor(
                slugSelector(`/blog/${postSlugValue}`, lang),
              )}
              image={image}
            />
          </div>
        </div>
        {/* Gate the island on its enable flag: mounting it unconditionally
          shipped the ~21 KB Disqus chunk on every post even while Disqus
          was disabled (the component itself only rendered null). */}
        {config.disqus.enable && (
          <Disqus className="mt-20" client:only="react" />
        )}
      </article>
    </div>

    <!-- Related posts -->
    <div class="section pb-0">
      <h2 class="h3 mb-12 text-center">Related Posts</h2>
      <div class="row justify-center">
        {similarPosts.map((post) => (
          <div class="lg:col-4 md:col-6 mb-14">
            <BlogCard data={post} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
