---
import BlogCard from "@/components/BlogCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Mermaid from "@/components/Mermaid.astro";
import OpenRemarkComment from "@/components/OpenRemarkComment.astro";
import Share from "@/components/Share.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser";
import { displayAuthorNames, resolveAuthors } from "@/lib/utils/authors";
import dateFormat from "@/lib/utils/dateFormat";
import { resolveContentDates, toIso } from "@/lib/utils/dates";
import readingTime from "@/lib/utils/readingTime";
import { canonicalFor } from "@/lib/utils/seo";
import { postSlug, postUrl } from "@/lib/utils/slug";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { getCollection, render } from "astro:content";
import { FaRegClock, FaRegFolder, FaRegUserCircle } from "react-icons/fa";
import ImageMod from "./components/ImageMod.astro";

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;

const posts = await getSinglePage(COLLECTION_FOLDER);
// Ranked by shared categories, then shared tags, then recency; capped at 3.
const similarPosts = similarItems(post, posts).slice(0, 3);
const { Content, headings } = await render(post);
const {
  title,
  description,
  authors,
  categories,
  image,
  ogImage,
  twitterTitle,
  twitterDescription,
  twitterImage,
  pinterestDescription,
  pinterestImage,
  datePublished,
  dateModified,
  tags,
} = post.data;

// Display dates (UTC): publication date always; an "Updated" date
// only when the post was meaningfully edited after publication.
const dates = resolveContentDates({ datePublished, dateModified });
const showUpdated =
  dates.dateModified &&
  dates.datePublished &&
  dates.dateModified.getTime() !== dates.datePublished.getTime();

// Visible breadcrumb trail — mirrors the JSON-LD BreadcrumbList exactly:
// Home → Blog → Category → Title. The category crumb is the first real
// category ("others" is filler, never a crumb).
const firstCategory = (categories ?? []).find(
  (category: string) => category.toLowerCase() !== "others",
);

// Reading time from the raw Markdown body.
const reading_time = readingTime(post.body ?? "");

// Authors resolved against the authors collection (file id first, legacy
// display-name match as fallback). Unresolved names render as plain text
// with no link — never a link to a 404 author page.
const allAuthors = await getCollection("authors");
const resolvedAuthors = resolveAuthors(
  displayAuthorNames({ data: { authors } }),
  allAuthors,
);
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog" },
            ...(firstCategory
              ? [
                  {
                    label: firstCategory,
                    href: `/categories/${slugify(firstCategory)}`,
                  },
                ]
              : []),
            { label: title },
          ]}
        />
        {image && (
          <div class="mb-10">
            <ImageMod
              src={image}
              height={675}
              width={1200}
              alt={title}
              loading="eager"
              fetchpriority="high"
              class="w-full rounded"
              format="webp"
              sizes="(max-width: 768px) 100vw, 1200px"
              widths={[800]}
            />
          </div>
        )}
        <h1 class="h2 mb-4">
          <span set:html={markdownify(title)} />
        </h1>
        <ul class="mb-4">
          <li class="mr-4 inline-block">
            {resolvedAuthors.map((resolved, index: number) => (
              <>
                {resolved.url ? (
                  <a href={resolved.url}>
                    <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
                    {humanize(resolved.name)}
                  </a>
                ) : (
                  <span>
                    <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
                    {humanize(resolved.name)}
                  </span>
                )}
                {index !== resolvedAuthors.length - 1 && ", "}
              </>
            ))}
          </li>
          <li class="mr-4 inline-block">
            <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
            {categories.map((category: string, index: number) => (
              <a href={`/categories/${slugify(category)}`}>
                {humanize(category)}
                {index !== categories.length - 1 && ","}
              </a>
            ))}
          </li>
          <li class="mr-4 inline-block">
            <FaRegClock className={"mr-2 -mt-1 inline-block"} />
            {dates.datePublished && (
              <time datetime={toIso(dates.datePublished)}>
                {dateFormat(dates.datePublished)}
              </time>
            )}
            {showUpdated && dates.dateModified && (
              <>
                {" · Updated "}
                <time datetime={toIso(dates.dateModified)}>
                  {dateFormat(dates.dateModified)}
                </time>
              </>
            )}
          </li>
          <li class="mr-4 inline-block">{reading_time}</li>
        </ul>
        <TableOfContents headings={headings} />
        <div class="content mb-10">
          <Content />
        </div>
        <Mermaid content={post.body} />
        <div class="row items-start justify-between">
          <div class="mb-10 flex items-center lg:col-5 lg:mb-0">
            <span class="h5 mr-3">Tags :</span>
            <ul>
              {tags.map((tag: string) => (
                <li class="inline-block">
                  <a
                    class="m-1 block rounded bg-light px-3 py-1 hover:bg-primary hover:text-white dark:bg-darkmode-light dark:hover:bg-darkmode-primary dark:hover:text-text-dark"
                    href={`/tags/${slugify(tag)}`}
                  >
                    {humanize(tag)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="flex items-center lg:col-4">
            <span class="h5 mr-3">Share :</span>
            <Share
              className="social-icons"
              title={title}
              description={description}
              slug={postSlug(post)}
              url={canonicalFor(postUrl(post))}
              image={image}
              ogImage={ogImage}
              twitterTitle={twitterTitle}
              twitterDescription={twitterDescription}
              twitterImage={twitterImage}
              pinterestDescription={pinterestDescription}
              pinterestImage={pinterestImage}
            />
          </div>
        </div>
        {/* Disqus is intentionally NOT imported here. A static import of
          the client:only island made Astro emit the ~21 KB Disqus chunk
          on every build even while disqus.enable was false — the render
          gate alone did not stop the bundler, because the island stays
          in the module graph. To re-enable comments, re-add
          `import config from "@/config/config.json";` and
          `import Disqus from "@/helpers/Disqus";` at the top and render
          `{config.disqus.enable && (<Disqus className="mt-20" client:only="react" />)}`
          here. src/layouts/helpers/Disqus.tsx and the disqus-react
          dependency are kept so re-enabling is a small change. */}
        {/* OpenRemark comments (self-hosted) — rendered where Disqus was. */}
        {config["open-remark-comment"].enable && (
          <OpenRemarkComment siteKey={config["open-remark-comment"].siteKey} />
        )}
      </article>
    </div>

    <!-- Related posts -->
    <div class="section pb-0">
      <h2 class="h3 mb-12 text-center">Related Posts</h2>
      <div class="row justify-center">
        {similarPosts.map((post) => (
          <div class="lg:col-4 md:col-6 mb-14">
            <BlogCard data={post} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
