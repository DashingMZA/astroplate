---
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { slugify } from "@/lib/utils/textConverter";
import { IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings } = config;
const { pathname } = Astro.url;
---

<header class={`header z-30 ${settings.sticky_header && "sticky top-0"}`}>
  <nav class="navbar container">
    <!-- logo -->
    <div class="order-0">
      <Logo />
    </div>
    <!-- navbar toggler: a real button (keyboard-focusable, exposes its
      state via aria-expanded). The old hidden-checkbox + label hack could
      never receive keyboard focus and its aria-expanded was hardcoded. -->
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open menu"
      class="order-3 flex items-center lg:hidden text-text-dark dark:text-white lg:order-1"
    >
      <svg
        id="show-button"
        class="h-6 fill-current block"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg
        id="hide-button"
        class="h-6 fill-current hidden"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"
        ></polygon>
      </svg>
    </button>
    <!-- /navbar toggler -->
    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full pb-6 lg:order-1 lg:flex lg:w-auto lg:space-x-2 lg:pb-0 xl:space-x-8"
    >
      {main.map((menu) => (
        <>
          {menu.hasChildren ? (
            <li class="nav-item nav-dropdown group relative">
              {/* Submenu toggle is a real button: keyboard-operable, with
                aria-expanded synced by the script below. The submenu list
                opens on click, on hover (mouse) and on :focus-within
                (keyboard) — never hover-only — and `lg:invisible` is only
                lifted by those states or by the button's data-open. */}
              <button
                type="button"
                data-submenu-toggle
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls={`submenu-${slugify(menu.name)}`}
                class={`nav-link inline-flex items-center ${
                  menu.children?.map(({ url }) => url).includes(pathname) ||
                  menu.children?.map(({ url }) => `${url}/`).includes(pathname)
                    ? "active"
                    : ""
                }`}
              >
                {menu.name}
                <svg
                  class="h-4 w-4 fill-current"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                </svg>
              </button>
              <ul
                id={`submenu-${slugify(menu.name)}`}
                class="nav-dropdown-list hidden lg:invisible lg:absolute lg:block lg:opacity-0 lg:group-hover:visible lg:group-hover:opacity-100 lg:group-focus-within:visible lg:group-focus-within:opacity-100"
              >
                {menu.children?.map((child) => (
                  <li class="nav-dropdown-item">
                    <a
                      href={child.url}
                      aria-label={child.name}
                      class={`nav-dropdown-link block ${
                        (pathname === `${child.url}/` ||
                          pathname === child.url) &&
                        "active"
                      }`}
                    >
                      {child.name}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="nav-item">
              <a
                href={menu.url}
                class={`nav-link block ${
                  (pathname === `${menu.url}/` || pathname === menu.url) &&
                  "active"
                }`}
              >
                {menu.name}
              </a>
            </li>
          )}
        </>
      ))}
      {navigation_button.enable && (
        <li class="mt-4 inline-block lg:hidden">
          <a
            class="btn btn-outline-primary btn-sm"
            href={navigation_button.link}
            target={
              navigation_button.link.startsWith("http") ? "_blank" : "_self"
            }
            rel={navigation_button.link.startsWith("http") ? "noopener" : ""}
          >
            {navigation_button.label}
          </a>
        </li>
      )}
    </ul>
    <div class="order-1 ml-auto flex items-center md:order-2 lg:ml-0">
      {settings.search && (
        <button
          class="border-border text-text-dark hover:text-primary dark:border-darkmode-border mr-5 inline-block border-r pr-5 text-xl dark:text-white dark:hover:text-darkmode-primary"
          aria-label="search"
          data-search-trigger
        >
          <IoSearch />
        </button>
      )}
      <ThemeSwitcher className="mr-5" />
      {navigation_button.enable && (
        <a
          class="btn btn-outline-primary btn-sm hidden lg:inline-block"
          href={navigation_button.link}
          target={
            navigation_button.link.startsWith("http") ? "_blank" : "_self"
          }
          rel={navigation_button.link.startsWith("http") ? "noopener" : ""}
        >
          {navigation_button.label}
        </a>
      )}
    </div>
  </nav>
</header>

<script>
  // Mobile nav + dropdown submenus (disclosure pattern).
  // Listeners live on the nav element itself so a view-transition swap
  // (which replaces the header DOM) drops them with it; init is guarded
  // per-element and re-run on astro:after-swap. Focus stays on the toggle
  // button while the menu is open (standard disclosure behaviour); Escape
  // closes the open menu/submenu and returns focus to its toggle.
  function initHeaderNav() {
    const nav = document.querySelector(".navbar");
    if (!nav || nav.hasAttribute("data-nav-bound")) {
      return;
    }
    nav.setAttribute("data-nav-bound", "");
    const toggle = nav.querySelector<HTMLButtonElement>("#nav-toggle");
    const menu = nav.querySelector<HTMLElement>("#nav-menu");
    if (!toggle || !menu) {
      return;
    }
    const showIcon = nav.querySelector("#show-button");
    const hideIcon = nav.querySelector("#hide-button");
    const isDesktop = () =>
      window.matchMedia("(min-width: 1024px)").matches;

    const setMenuOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.classList.toggle("hidden", !open);
      showIcon?.classList.toggle("hidden", open);
      hideIcon?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => {
      setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav
      .querySelectorAll<HTMLButtonElement>("[data-submenu-toggle]")
      .forEach((button) => {
        const listId = button.getAttribute("aria-controls");
        const list = listId ? document.getElementById(listId) : null;
        if (!list) {
          return;
        }
        button.addEventListener("click", () => {
          const open = button.getAttribute("aria-expanded") !== "true";
          button.setAttribute("aria-expanded", String(open));
          list.toggleAttribute("data-open", open);
        });
      });

    // Escape closes the open submenu first (focus back to its button),
    // otherwise the mobile menu (focus back to the toggle). On desktop the
    // menu is always visible, so only submenus close there.
    nav.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key !== "Escape") {
        return;
      }
      const openSubmenu = nav.querySelector<HTMLElement>(
        ".nav-dropdown-list[data-open='true']",
      );
      if (openSubmenu) {
        const button = nav.querySelector<HTMLButtonElement>(
          `[data-submenu-toggle][aria-controls="${openSubmenu.id}"]`,
        );
        openSubmenu.removeAttribute("data-open");
        button?.setAttribute("aria-expanded", "false");
        button?.focus();
        return;
      }
      if (
        toggle.getAttribute("aria-expanded") === "true" &&
        !isDesktop()
      ) {
        setMenuOpen(false);
        toggle.focus();
      }
    });
  }

  initHeaderNav();
  document.addEventListener("astro:after-swap", initHeaderNav);
</script>
