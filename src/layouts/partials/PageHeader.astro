---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { humanize } from "@/lib/utils/textConverter";

const { title = "" }: { title?: string } = Astro.props;
---

<section>
  <div class="container text-center">
    <div class="rounded-2xl bg-gradient-to-b from-body to-light px-8 py-14 dark:from-darkmode-body dark:to-darkmode-light">
      {/* Expression child (not set:text): the heading text is visible to
        the jsx-a11y heading-has-content rule. */}
      <h1>{humanize(title)}</h1>
      <Breadcrumbs className="mt-6" />
    </div>
  </div>
</section>
