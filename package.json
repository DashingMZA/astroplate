{
  "name": "astroplate-multilingual",
  "version": "6.2.2",
  "description": "Astro and Tailwindcss Multilingual boilerplate",
  "author": "zeon.studio",
  "license": "MIT",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"node scripts/jsonGenerator.js && astro dev\"",
    "build": "node scripts/themeGenerator.js && node scripts/jsonGenerator.js && astro build && node scripts/llmsGenerator.js",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier -w ./src",
    "test": "node --test tests/",
    "generate-json": "node scripts/jsonGenerator.js",
    "generate-llms": "node scripts/llmsGenerator.js",
    "remove-darkmode": "node scripts/removeDarkmode.js && pnpm format",
    "deploy:cf-workers": "pnpm build && wrangler deploy",
    "preview:cf-workers": "pnpm build && wrangler dev",
    "remove-multilang": "node scripts/removeMultilang.js && pnpm format"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "8.1.5",
    "@astrojs/react": "7.1.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@digi4care/astro-google-tagmanager": "^2.1.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@playform/compress": "^0.2.5",
    "astro": "7.4.11",
    "astro-auto-import": "^0.6.0",
    "astro-swiper": "^2.11.0",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "mermaid": "^12.3.0",
    "date-fns": "^4.4.0",
    "disqus-react": "^1.1.7",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.0",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@astrojs/check": "^0.9.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "glob": "^14.0.6",
    "node-html-parser": "^9.0.7",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "turndown": "^7.2.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  }
}
